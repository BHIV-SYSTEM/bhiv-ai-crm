# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/ai_crm_logistics?retryWrites=true&w=majority

# Server Configuration
PORT=8000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
SETU_MITRA_API_KEY=

# SETU integration credential - required by the /setu, /api/setu, /v1/setu,
# /projects and /tasks routers. Callers may authenticate with EITHER a user JWT
# (Authorization: Bearer <jwt>) OR this key (X-SETU-API-Key: <key>).
# Machine callers (Artha signal dispatch, SHAKTI PMC) must send this key.
# Leave unset to accept JWTs only.
SETU_INTEGRATION_API_KEY=

# Email Configuration (NodeMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=AI CRM Logistics

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://mitra-live-runtime-sprint.vercel.app

# Admin Configuration
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator

# UniGuru AI Service Configuration
UNIGURU_SERVICE_URL=http://163.128.209.18:8007
UNIGURU_API_TOKEN=your-uniguru-api-token
UNIGURU_CALLER_NAME=bhiv-setu

# ARTHA Financial API Bridge (client financial workspace)
# Base URL of the AI-Artha backend (its own /api/v1 surface)
ARTHA_API_URL=http://localhost:5000
# HS256 secret shared with ARTHA (must equal one of ARTHA's accepted JWT secrets:
# JWT_SECRET / BHIV_JWT_SECRET / AUTH_JWT_SECRET / BLACKHOLE_JWT_SECRET).
# SETU signs short-lived read-scoped tokens with it; ARTHA still enforces the
# user's role and company scope from its own database.
ARTHA_JWT_SECRET=
# Optional: token lifetime for bridged tokens (default 1h)
ARTHA_BRIDGE_TOKEN_TTL=1h
# Optional: upstream timeout in ms (default 10000)
ARTHA_TIMEOUT_MS=10000
# Tenant -> ARTHA identity map (JSON). Keyed by the authenticated SETU tenant_id.
# The browser can NEVER choose the company: only this server-side map does.
# ARTHA_CLIENT_MAP={"tenant_bright_connection_001":{"user_id":"<artha-user-id>","company_id":"<artha-company-id>","email":"client@example.com","name":"Bright Connection Client"}}
